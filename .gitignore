# Gradle, Kotlin and Android generated files. Keep gradle/wrapper tracked.
.gradle/
.kotlin/
.tools/
**/build/
/app/debug/
/app/release/
out/
bin/
.cxx/
.externalNativeBuild/
*.class
*.dex
*.apk
*.aab
*.ap_
*.hprof

# Machine-specific configuration and private source settings.
local.properties
*.local.*
.env
.env.*
!.env.example
key.properties
keystore.properties
signing.properties
secrets.properties
secrets.*.properties
!secrets.example.properties
source-config*.json
!source-config.example.json
google-services.json
*credentials*.json
*client_secret*.json
service-account*.json
service_account*.json
.git-credentials
.netrc
.aws/
.ssh/
.codex/
.agents/

# Signing and private key material.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.pk8
id_rsa
id_ed25519

# Real playlists and local databases may contain provider credentials.
*.m3u
*.m3u8
!*.example.m3u
!*.example.m3u8
!app/src/**/resources/fixtures/*.m3u
!app/src/**/resources/fixtures/*.m3u8
*.db
*.db-*
*.sqlite
*.sqlite3

# Generated logs, verification output and local scratch files.
*.log
logs/
captures/
docs/verification/
prototype/verification.json
/test

# IDE and operating-system state.
.idea/
.vscode/
.fleet/
*.iml
*.ipr
*.iws
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
